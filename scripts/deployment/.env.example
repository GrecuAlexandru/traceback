# Production runtime CONTRACT, not a runnable local .env. Values are placeholders.
# Inject secrets through reviewed runtime files/Secrets Manager; never bake this into images.
TRACEBACK_ENVIRONMENT=production
SPRING_PROFILES_ACTIVE=production
# Worker instead: SPRING_PROFILES_ACTIVE=production,worker; TRACEBACK_RUNTIME=worker
TRACEBACK_RUNTIME=api
DATABASE_URL=jdbc:postgresql://REVIEWED_RDS_HOST/traceback?sslmode=verify-full&sslrootcert=/certs/rds.pem&connectTimeout=3&socketTimeout=35
DATABASE_USER=traceback_api
DATABASE_PASSWORD=REPLACE_FROM_RUNTIME_SECRET
DB_POOL_SIZE=8
AWS_REGION=APPROVED_REGION
S3_BUCKET=REVIEWED_PRIVATE_BUCKET
S3_KMS_KEY_ARN=REVIEWED_DOCUMENT_KEY_ARN
SQS_QUEUE=REVIEWED_QUEUE_NAME
EXTRACTION_RUNTIME=docker-host
PDF_EXTRACTION_IMAGE=REVIEWED_REGISTRY/traceback-pdf@sha256:REVIEWED_64_HEX_DIGEST
# Requires a dedicated trusted daemon/cgroup-v2 review; Fargate cannot use this unchanged.
DOCUMENT_STORAGE_DIRECTORY=/var/lib/traceback/documents
LEGACY_STORAGE_ENABLED=true
API_REPLICAS=1
MCP_ENABLED=false
INDEXING_ENABLED=false
CHAT_ENABLED=false
# Keep approved installed model/digest settings when separately enabling inference.
OIDC_ISSUER=https://auth.example.invalid/realms/traceback
APP_ORIGIN=https://app.example.invalid
BACKEND_ORIGIN=https://api.internal.example.invalid
OIDC_CLIENT_ID=traceback-web
ALLOW_LOCAL_HTTP=false
FRONTEND_REPLICAS=1
SESSION_STORE=memory-single-process
# Separate one-shot migration environment ONLY (not injected into running API/workers):
# MIGRATION_USER=reviewed_schema_owner
# MIGRATION_PASSWORD=REPLACE_FROM_MIGRATION_SECRET
