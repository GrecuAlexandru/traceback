# Local environment files and credentials (at any repository depth)
.env
.env.*
!.env.example
*.pem
*.key

# Python smoke-test tooling
__pycache__/
*.py[cod]

# Frontend dependencies/builds and local test output
node_modules/
.next/
*.tsbuildinfo
playwright-report/
test-results/

# Terraform plans/state can include credentials and private infrastructure metadata.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.auto.tfvars
*.tfvars
!*.tfvars.example
crash.log
