# Server-only configuration. Existing approved local PKCE callback is exact.
APP_ORIGIN=http://127.0.0.1:8765
OIDC_ISSUER=http://localhost:8180/realms/traceback
OIDC_CLIENT_ID=traceback-web-test
BACKEND_ORIGIN=http://127.0.0.1:8080
# Explicitly permits HTTP only for loopback development endpoints.
ALLOW_LOCAL_HTTP=true
# Match backend resource limits if changed; these do not override backend validation.
DOCUMENT_MAX_FILE_BYTES=10485760
CHAT_MAX_QUESTION_BYTES=1000
