{
  "realm": "traceback-m14-test",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "traceback-mcp",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "attributes": {
        "resource_url": "http://127.0.0.1:18084/mcp"
      }
    },
    {
      "clientId": "traceback-mcp-test",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://127.0.0.1:8765/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "standard.token.exchange.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "oauth2.jwt.authorization.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "traceback-mcp",
            "access.token.claim": "true"
          }
        },
        {
          "name": "human",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "traceback_principal_type",
            "claim.value": "human",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "traceback-rest-test",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://127.0.0.1:8765/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "standard.token.exchange.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "oauth2.jwt.authorization.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "traceback-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "human",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "traceback_principal_type",
            "claim.value": "human",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "traceback-mcp-machine",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "standard.token.exchange.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "oauth2.jwt.authorization.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "traceback-mcp",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
