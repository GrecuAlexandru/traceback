# Local development only. Compose reads this file after copying to .env.
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-development-password
# Export these variables for a host-run Java API/worker (Spring does not read .env itself).
LOCAL_AWS_ENABLED=true
LOCAL_AWS_ENDPOINT=http://localhost:4566
LOCAL_S3_BUCKET=traceback-documents-local
LOCAL_SQS_QUEUE=traceback-ingestion-local
DOCUMENT_STORAGE_PROVIDER=S3
# Must be the same initialized, private absolute path for API and local legacy worker.
# DOCUMENT_STORAGE_DIRECTORY=/absolute/private/path/outside/checkout
